# Supabase project API URL. This URL is public.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase publishable key (or legacy anon key). This key is designed for browser use;
# Row Level Security must protect every exposed table. Never use a service-role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Public production origin used for canonical URLs and the generated sitemap.
VITE_SITE_URL=https://front-ecommerce-gamma.vercel.app
